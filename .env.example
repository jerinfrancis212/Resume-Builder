# Supabase project settings (Project Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side Supabase credentials (Vercel Environment Variables — NEVER expose in browser)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay Payment Gateway (use Test Mode keys first: rzp_test_...)
VITE_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: enable AI summary suggestions
VITE_ENABLE_AI=false
GEMINI_API_KEY=
